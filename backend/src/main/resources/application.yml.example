spring:
  application:
    name: capstone-backend

  datasource:
    url: jdbc:postgresql://localhost:5432/capstone
    username: 본인_DB_사용자명
    password: '본인_DB_비밀번호'
    driver-class-name: org.postgresql.Driver

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true
        dialect: org.hibernate.dialect.PostgreSQLDialect

server:
  port: 8080
